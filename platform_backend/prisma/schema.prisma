generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model api_keys {
  api_key_id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_user_id String?         @db.Uuid
  key_name         String
  api_key_hash     String
  last_used_at     DateTime?       @db.Timestamptz(6)
  expires_at       DateTime?       @db.Timestamptz(6)
  is_active        Boolean?        @default(true)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  platform_users   platform_users? @relation(fields: [platform_user_id], references: [platform_user_id], onDelete: Cascade, onUpdate: NoAction)
}

model login_attempts {
  attempt_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @db.Citext
  ip_address   String?   @db.Inet
  success      Boolean?  @default(false)
  attempted_at DateTime? @default(now()) @db.Timestamptz(6)
}

model platform_users {
  platform_user_id String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String          @unique @db.Citext
  password_hash    String
  role             platform_role
  is_active        Boolean?        @default(true)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?       @db.Timestamptz(6)
  deleted_by       String?         @db.Uuid
  api_keys         api_keys[]
  user_sessions    user_sessions[]
}

model user_sessions {
  session_id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_user_id String?         @db.Uuid
  token            String          @unique
  expires_at       DateTime        @db.Timestamptz(6)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  revoked_at       DateTime?       @db.Timestamptz(6)
  platform_users   platform_users? @relation(fields: [platform_user_id], references: [platform_user_id], onDelete: Cascade, onUpdate: NoAction)
}

enum platform_role {
  super_admin
  support_admin
  billing_admin
}
