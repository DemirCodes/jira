/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model organizations {
  org_id                                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_check_id                          String                     @unique
  org_name                              String
  org_description                       String?
  slug                                  String                     @unique
  org_status                            String                     @default("active")
  created_by                            String?                    @db.Uuid
  created_at                            DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime                   @default(now()) @db.Timestamptz(6)
  deleted_at                            DateTime?                  @db.Timestamptz(6)
  deleted_by                            String?                    @db.Uuid
  application_bugs                      application_bugs[]
  invitations                           invitations[]
  organization_assets                   organization_assets[]
  organization_memberships              organization_memberships[]
  users_organizations_created_byTousers users?                     @relation("organizations_created_byTousers", fields: [created_by], references: [user_id], onUpdate: NoAction)
  users_organizations_deleted_byTousers users?                     @relation("organizations_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  sites                                 sites[]
}

