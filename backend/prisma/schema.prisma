  users_organization_memberships_invited_byTousers users?        @relation("organization_memberships_invited_byTousers", fields: [invited_by], references: [user_id], onUpdate: NoAction)
  organizations                                    organizations @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  users_organization_memberships_user_idTousers    users         @relation("organization_memberships_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

