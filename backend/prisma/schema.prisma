model projects {
  project_id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id                            String                 @db.Uuid
  project_check_id                   String                 @unique
  project_name                       String
  project_description                String?
  slug                               String?
  project_status                     project_status         @default(active)
  created_by                         String?                @db.Uuid
  completed_at                       DateTime?              @db.Timestamptz(6)
  completed_by                       String?                @db.Uuid
  created_at                         DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                         DateTime?              @db.Timestamptz(6)
  deleted_by                         String?                @db.Uuid
  is_private                         Boolean                @default(false)
  application_bugs                   application_bugs[]
  issues                             issues[]
  project_assets                     project_assets[]
  project_memberships                project_memberships[]
  project_requirements               project_requirements[]
  users_projects_completed_byTousers users?                 @relation("projects_completed_byTousers", fields: [completed_by], references: [user_id], onUpdate: NoAction)
  users_projects_created_byTousers   users?                 @relation("projects_created_byTousers", fields: [created_by], references: [user_id], onUpdate: NoAction)
  users_projects_deleted_byTousers   users?                 @relation("projects_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  sites                              sites                  @relation(fields: [site_id], references: [site_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([site_id, project_name])
}

