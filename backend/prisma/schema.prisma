generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model application_bugs {
  bug_id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reported_by   String          @db.Uuid
  org_id        String?         @db.Uuid
  project_id    String?         @db.Uuid
  title         String
  description   String
  status        bug_status      @default(open)
  priority      priority_level? @default(medium)
  assigned_to   String?         @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  resolved_at   DateTime?       @db.Timestamptz(6)
  deleted_at    DateTime?       @db.Timestamptz(6)
  deleted_by    String?         @db.Uuid
  organizations organizations?  @relation(fields: [org_id], references: [org_id], onUpdate: NoAction)
  projects      projects?       @relation(fields: [project_id], references: [project_id], onUpdate: NoAction)
  users         users           @relation(fields: [reported_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invitations {
  invitation_id                            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                                   String        @db.Uuid
  invited_by                               String        @db.Uuid
  invited_user_id                          String        @db.Uuid
  entity_type                              String
  entity_id                                String?       @db.Uuid
  role                                     String
  status                                   String        @default("pending")
  created_at                               DateTime?     @default(now()) @db.Timestamptz(6)
  expires_at                               DateTime?     @default(dbgenerated("(now() + '7 days'::interval)")) @db.Timestamptz(6)
  accepted_at                              DateTime?     @db.Timestamptz(6)
  rejected_at                              DateTime?     @db.Timestamptz(6)
  cancelled_at                             DateTime?     @db.Timestamptz(6)
  deleted_at                               DateTime?     @db.Timestamptz(6)
  users_invitations_invited_byTousers      users         @relation("invitations_invited_byTousers", fields: [invited_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  users_invitations_invited_user_idTousers users         @relation("invitations_invited_user_idTousers", fields: [invited_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  organizations                            organizations @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
}

model issue_activity {
  activity_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issue_id    String    @db.Uuid
  user_id     String?   @db.Uuid
  field_name  String
  old_value   String?
  new_value   String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  issues      issues    @relation(fields: [issue_id], references: [issue_id], onDelete: Cascade, onUpdate: NoAction)
  users       users?    @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

model issue_assets {
  issue_asset_id                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issue_id                              String     @db.Uuid
  uploaded_by                           String?    @db.Uuid
  asset_type                            asset_type
  file_name                             String
  mime_type                             String?
  byte_size                             BigInt?
  storage_key                           String
  checksum                              String?
  metadata                              Json?      @default("{}")
  is_active                             Boolean    @default(true)
  created_at                            DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                            DateTime?  @db.Timestamptz(6)
  deleted_by                            String?    @db.Uuid
  users_issue_assets_deleted_byTousers  users?     @relation("issue_assets_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  issues                                issues     @relation(fields: [issue_id], references: [issue_id], onDelete: Cascade, onUpdate: NoAction)
  users_issue_assets_uploaded_byTousers users?     @relation("issue_assets_uploaded_byTousers", fields: [uploaded_by], references: [user_id], onUpdate: NoAction)
}

model issue_memberships {
  issue_membership_id                       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issue_id                                  String     @db.Uuid
  user_id                                   String     @db.Uuid
  role                                      issue_role
  membership_is_active                      Boolean    @default(true)
  created_at                                DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                                DateTime?  @db.Timestamptz(6)
  deleted_by                                String?    @db.Uuid
  users_issue_memberships_deleted_byTousers users?     @relation("issue_memberships_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  issues                                    issues     @relation(fields: [issue_id], references: [issue_id], onDelete: Cascade, onUpdate: NoAction)
  users_issue_memberships_user_idTousers    users      @relation("issue_memberships_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model issues {
  issue_id                                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                                    String              @db.Uuid
  issue_no                                      BigInt
  issue_title                                   String
  issue_description                             String?
  status                                        issue_status        @default(open)
  priority                                      priority_level?     @default(medium)
  reporter_id                                   String?             @db.Uuid
  assignee_id                                   String?             @db.Uuid
  parent_issue_id                               String?             @db.Uuid
  blocking_issue_id                             String?             @db.Uuid
  issue_is_active                               Boolean             @default(true)
  created_at                                    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at                                    DateTime?           @db.Timestamptz(6)
  deleted_by                                    String?             @db.Uuid
  is_private                                    Boolean             @default(false)
  is_editable                                   Boolean             @default(false)
  issue_activity                                issue_activity[]
  issue_assets                                  issue_assets[]
  issue_memberships                             issue_memberships[]
  users_issues_assignee_idTousers               users?              @relation("issues_assignee_idTousers", fields: [assignee_id], references: [user_id], onUpdate: NoAction)
  issues_issues_blocking_issue_idToissues       issues?             @relation("issues_blocking_issue_idToissues", fields: [blocking_issue_id], references: [issue_id], onUpdate: NoAction)
  other_issues_issues_blocking_issue_idToissues issues[]            @relation("issues_blocking_issue_idToissues")
  users_issues_deleted_byTousers                users?              @relation("issues_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  issues_issues_parent_issue_idToissues         issues?             @relation("issues_parent_issue_idToissues", fields: [parent_issue_id], references: [issue_id], onUpdate: NoAction)
  other_issues_issues_parent_issue_idToissues   issues[]            @relation("issues_parent_issue_idToissues")
  projects                                      projects            @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction)
  users_issues_reporter_idTousers               users?              @relation("issues_reporter_idTousers", fields: [reporter_id], references: [user_id], onUpdate: NoAction)

  @@unique([project_id, issue_no])
}

model notifications {
  notification_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  type            String
  title           String
  content         String?
  metadata        Json?     @default("{}")
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  read_at         DateTime? @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)
  users           users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

