  organizations                                organizations @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  users_organization_assets_uploaded_byTousers users?        @relation("organization_assets_uploaded_byTousers", fields: [uploaded_by], references: [user_id], onUpdate: NoAction)
