# ============================================
# SUNUCU AYARLARI
# ============================================
PORT=3030                      # Uygulamanın çalışacağı port
NODE_ENV=development           # Çevre: development, production, test

# ============================================
# TENANT DATABASE (jira - normal kullanıcılar)
# ============================================
TENANT_DB_HOST=localhost       # PostgreSQL sunucu adresi
TENANT_DB_PORT=5434            # PostgreSQL portu (host'ta 5434, container içi 5432)
TENANT_DB_NAME=jira            # Tenant database adı
TENANT_DB_USER=postgres        # Database kullanıcısı
TENANT_DB_PASSWORD=dmrcode     # Database şifresi


# Havuz ayarları (OPSİYONEL - default değerler)
TENANT_DB_POOL_MAX=20         # Maksimum bağlantı sayısı (default: 20)
TENANT_DB_POOL_MIN=2          # Minimum hazır bağlantı sayısı (default: 2)

# Timeout ayarları (OPSİYONEL - default değerler)
TENANT_DB_IDLE_TIMEOUT=30000           # Boş bağlantı kapatma süresi (ms) (default: 30000)
TENANT_DB_CONNECTION_TIMEOUT=10000     # Bağlantı kurma bekleme süresi (ms) (default: 10000)
TENANT_DB_STATEMENT_TIMEOUT=30000      # Query timeout süresi (ms) (default: 30000)

# SSL ayarları (OPSİYONEL - development'da disable)
TENANT_DB_SSL_MODE=disable     # SSL modu: disable | require | verify-full
# TENANT_DB_CA_CERT=           # CA sertifikası (verify-full modunda gerekli)
# TENANT_DB_CERT=              # Client sertifikası (verify-full modunda opsiyonel)
# TENANT_DB_KEY=               # Client key (verify-full modunda opsiyonel)

# ============================================
# PLATFORM DATABASE (jira_platform_db - adminler)
# ============================================
# Temel bağlantı bilgileri (ZORUNLU)
PLATFORM_DB_HOST=localhost      # Platform DB sunucu adresi
PLATFORM_DB_PORT=5434           # Platform DB port
PLATFORM_DB_NAME=jira_platform_db  # Platform database adı
PLATFORM_DB_USER=postgres       # Database kullanıcısı
PLATFORM_DB_PASSWORD=dmrcode    # Database şifresi

# Havuz ayarları (OPSİYONEL - default değerler)
PLATFORM_DB_POOL_MAX=20         # Maksimum bağlantı sayısı (default: 20)
PLATFORM_DB_POOL_MIN=2          # Minimum hazır bağlantı sayısı (default: 2)

# Timeout ayarları (OPSİYONEL - default değerler)
PLATFORM_DB_IDLE_TIMEOUT=30000           # Boş bağlantı kapatma süresi (ms) (default: 30000)
PLATFORM_DB_CONNECTION_TIMEOUT=10000     # Bağlantı kurma bekleme süresi (ms) (default: 10000)
PLATFORM_DB_STATEMENT_TIMEOUT=30000      # Query timeout süresi (ms) (default: 30000)

# SSL ayarları (OPSİYONEL - development'da disable)
PLATFORM_DB_SSL_MODE=disable     # SSL modu: disable | require | verify-full
# PLATFORM_DB_CA_CERT=           # CA sertifikası (verify-full modunda gerekli)
# PLATFORM_DB_CERT=              # Client sertifikası (verify-full modunda opsiyonel)
# PLATFORM_DB_KEY=               # Client key (verify-full modunda opsiyonel)

# ============================================
# NOTLAR:
# ============================================
# 1. Tenant ve Platform DB aynı PostgreSQL instance'ında çalışıyorsa
#    aynı HOST ve PORT değerlerini kullanabilirsiniz.
# 
# 2. SSL Modları:
#    - disable: SSL kullanma (sadece development)
#    - require: SSL kullan ama sertifika doğrulama (staging)
#    - verify-full: SSL kullan + sertifika doğrula (production)
# 
# 3. Timeout değerleri milisaniye cinsindendir.
#    10000 = 10 saniye, 30000 = 30 saniyeJWT_SECRET=Vz5Qs8exhOiOX+5aLEJk1NMRjbz/oPyWpTmknFKnZdM=
JWT_REFRESH_SECRET=6HBsTyBzdggoZ8CWpJwLA+Dw4fEOznwp4Oj9S6tZrZY=
JWT_EXPIRES_IN=7d
