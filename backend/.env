# Server
PORT=3030
NODE_ENV=development

# Tenant Database (jira)
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_NAME=jira
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres

# Platform Database (jira_platform_db)
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5433
PLATFORM_DB_NAME=jira_platform_db
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# BCrypt
BCRYPT_SALT_ROUNDS=10